<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="780.0" prefWidth="820.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ManageActivitiesController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIManageActivitiesStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PROFESOR · ACTIVIDADES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Gestión de Actividades del Proyecto" styleClass="viewTitleLabel"/>
                        <Label text="Carga las actividades del proyecto y administra sus datos, fechas y prórrogas."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Actividades registradas" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <HBox spacing="12.0">
                                <ComboBox fx:id="projectComboBox"
                                          styleClass="formComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="Cargar" styleClass="primaryActionButton"
                                        onAction="#loadActivities" mnemonicParsing="false"/>
                            </HBox>

                            <TableView fx:id="activitiesTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="240.0">
                                <columns>
                                    <TableColumn fx:id="nameColumn" prefWidth="260.0" text="Nombre">
                                        <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="descriptionColumn" prefWidth="340.0" text="Descripción">
                                        <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9998;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Editar actividad seleccionada" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <VBox spacing="6.0">
                                <Label text="Nombre" styleClass="fieldLabelText"/>
                                <RestrictedTextField fx:id="nameTextField"
                                                     styleClass="formTextField" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Descripción" styleClass="fieldLabelText"/>
                                <TextArea fx:id="descriptionTextArea"
                                          wrapText="true" styleClass="formTextArea"
                                          prefHeight="90.0" maxWidth="Infinity"/>
                            </VBox>

                            <HBox spacing="14.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Fecha de inicio" styleClass="fieldLabelText"/>
                                    <DatePicker fx:id="fechaInicioPicker"
                                                styleClass="formDatePicker" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Fecha límite de entrega" styleClass="fieldLabelText"/>
                                    <DatePicker fx:id="fechaFinPicker"
                                                styleClass="formDatePicker" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="statusLabel" text="" styleClass="uploadStatusLabel"/>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Button text="Actualizar" styleClass="primaryActionButton"
                                    onAction="#updateActivity" mnemonicParsing="false"/>
                            <Button text="Otorgar Prórroga" styleClass="warnActionButton"
                                    onAction="#grantProrroga" mnemonicParsing="false"/>
                            <Button text="Eliminar" styleClass="rejectActionButton"
                                    onAction="#deleteActivity" mnemonicParsing="false"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Limpiar" styleClass="cancelActionButton"
                                    onAction="#clearSelection" mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<ScrollPane
        styleClass="subViewScrollPane"
        fitToWidth="true"
        fitToHeight="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="GUI.Controller.AddCoordinatorController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIAddCoordinatorStyles.css"/>
    </stylesheets>

    <content>
        <VBox styleClass="subViewContentVBox" spacing="20.0">
            <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>
            <VBox styleClass="viewHeaderVBox" spacing="5.0">

                <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                    <Label text="ADMINISTRACIÓN · USUARIOS" styleClass="viewBreadcrumbLabel"/>
                </HBox>

                <Label text="Asignar Coordinador" styleClass="viewTitleLabel"/>

                <Label text="Asigna el rol de coordinador a un profesor existente. Solo puede haber un coordinador activo."
                       styleClass="viewSubtitleLabel"/>
            </VBox>

            <Separator styleClass="viewTopAccentSeparator"/>

            <VBox styleClass="formCardVBox">

                <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                    <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                    <StackPane styleClass="formSectionIconStackPane">
                        <Label text="+" styleClass="formSectionIconLabel"/>
                    </StackPane>
                    <Label text="Profesor a asignar" styleClass="formSectionTitleLabel"/>
                </HBox>

                <VBox spacing="18.0">
                    <padding><Insets top="26.0" right="36.0" bottom="26.0" left="36.0"/></padding>

                    <Label fx:id="statusLabel"
                           text="Selecciona al profesor que tomará el rol de coordinador."
                           wrapText="true"/>

                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text="Profesor" styleClass="fieldLabelText"/>
                        <Label text=" *" styleClass="requiredMarkLabel"/>
                    </HBox>
                    <ComboBox fx:id="professorComboBox"
                              promptText="Selecciona un profesor"
                              maxWidth="Infinity"/>
                </VBox>

                <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                    <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar"
                            styleClass="cancelActionButton"
                            onAction="#cancelRegistration"
                            mnemonicParsing="false"/>
                    <Button fx:id="assignButton"
                            text="Asignar rol"
                            styleClass="primaryActionButton"
                            onAction="#assignCoordinatorRole"
                            mnemonicParsing="false"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>

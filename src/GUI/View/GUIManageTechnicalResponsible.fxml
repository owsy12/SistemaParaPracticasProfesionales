<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="anchorPane" prefHeight="430.0" prefWidth="654.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ManageTechnicalResponsibleController">
   <children>
      <TableView fx:id="technicalResponsibleTableView"
                 layoutX="14.0" layoutY="40.0"
                 prefHeight="304.0" prefWidth="626.0">
         <columns>
            <TableColumn fx:id="nameColumn"           prefWidth="100.0" text="Nombre" />
            <TableColumn fx:id="lastNameColumn"       prefWidth="110.0" text="Apellido Paterno" />
            <TableColumn fx:id="secondLastNameColumn" prefWidth="110.0" text="Apellido Materno" />
            <TableColumn fx:id="emailColumn"          prefWidth="140.0" text="Correo" />
            <TableColumn fx:id="positionColumn"       prefWidth="100.0" text="Cargo" />
            <TableColumn fx:id="actionColumn"         prefWidth="66.0" />
         </columns>
      </TableView>
      <Button layoutX="14.0" layoutY="360.0" mnemonicParsing="false" onAction="#cancelAction" prefHeight="26.0" prefWidth="120.0" text="Cancelar" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="anchorPane" prefHeight="430.0" prefWidth="654.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ManageTechnicalResponsibleController">
   <children>
      <TableView fx:id="technicalResponsibleTableView"
                 layoutX="14.0" layoutY="40.0"
                 prefHeight="304.0" prefWidth="626.0">
         <columns>
            <TableColumn fx:id="nameColumn"           prefWidth="110.0" text="Nombre">
               <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="lastNameColumn"       prefWidth="120.0" text="Apellido Paterno">
               <cellValueFactory><PropertyValueFactory property="lastName"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="secondLastNameColumn" prefWidth="120.0" text="Apellido Materno">
               <cellValueFactory><PropertyValueFactory property="secondLastName"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="emailColumn"          prefWidth="156.0" text="Correo">
               <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="positionColumn"       prefWidth="120.0" text="Cargo">
               <cellValueFactory><PropertyValueFactory property="position"/></cellValueFactory>
            </TableColumn>
         </columns>
      </TableView>
      <Button layoutX="14.0"  layoutY="360.0" mnemonicParsing="false"
              onAction="#cancelAction" prefHeight="26.0" prefWidth="120.0" text="Cancelar" />
      <Button layoutX="520.0" layoutY="360.0" mnemonicParsing="false"
              onAction="#deleteTechnicalResponsible" prefHeight="26.0" prefWidth="120.0" text="Eliminar" />
   </children>
</AnchorPane>

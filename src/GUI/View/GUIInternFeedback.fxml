<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorPane"
            prefWidth="900.0"
            prefHeight="640.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.InternFeedbackController">
    <children>
        <VBox spacing="16.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding><Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/></padding>

            <Label text="Retroalimentación recibida" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Label text="Motivo de tu asignación de proyecto" style="-fx-font-weight: bold;"/>
            <Label fx:id="assignmentReasonLabel" text="" wrapText="true"/>

            <Label text="Observaciones de tus reportes" style="-fx-font-weight: bold;"/>
            <TableView fx:id="reportsTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="typeColumn" prefWidth="140.0" text="Tipo">
                        <cellValueFactory><PropertyValueFactory property="reportType"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="periodColumn" prefWidth="160.0" text="Período">
                        <cellValueFactory><PropertyValueFactory property="period"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Estado">
                        <cellValueFactory><PropertyValueFactory property="displayStatus"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="observationsColumn" prefWidth="360.0" text="Observaciones del profesor">
                        <cellValueFactory><PropertyValueFactory property="professorObservations"/></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>

            <Button text="Volver" onAction="#cancelAction" mnemonicParsing="false"/>
        </VBox>
    </children>
</AnchorPane>

          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Nombre" />
          <TableColumn fx:id="emailColumn" prefWidth="108.0" text="Correo" />
            <TableColumn fx:id="addressColumn" prefWidth="85.0" text="Dirección" />
            <TableColumn fx:id="sectorColumn" prefWidth="83.0" text="Sector" />
            <TableColumn fx:id="statusColumn" prefWidth="85.0" text="Estado" />
            <TableColumn fx:id="actionColumn" prefWidth="74.0" />
        </columns>
      </TableView>
      <Button layoutX="45.0" layoutY="320.0" mnemonicParsing="false" onAction="#cancelAction" prefHeight="26.0" prefWidth="120.0" text="Cancelar" />
   </children>
</AnchorPane>

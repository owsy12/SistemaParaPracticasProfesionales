<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.SelectProjectForActivityController">
   <children>
      <Label layoutX="20.0" layoutY="14.0" text="Seleccionar Proyecto para Actividades">
         <font><Font size="18.0"/></font>
      </Label>

      <TableView fx:id="projectsTable" layoutX="20.0" layoutY="50.0"
                 prefHeight="270.0" prefWidth="660.0">
         <columns>
            <TableColumn fx:id="colName" prefWidth="220.0" text="Nombre del proyecto">
               <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colOrganization" prefWidth="200.0" text="Organización">
               <cellValueFactory><PropertyValueFactory property="organizationNameDisplay"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Estado">
               <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPeriod" prefWidth="140.0" text="Período">
               <cellValueFactory><PropertyValueFactory property="periodDisplay"/></cellValueFactory>
            </TableColumn>
         </columns>
      </TableView>

      <Button fx:id="addActivityButton"
              layoutX="20.0" layoutY="340.0"
              mnemonicParsing="false"
              onAction="#openAddActivity"
              prefHeight="26.0" prefWidth="180.0"
              text="Agregar Actividad"
              disable="true" />
      <Button fx:id="manageActivitiesButton"
              layoutX="210.0" layoutY="340.0"
              mnemonicParsing="false"
              onAction="#openManageActivities"
              prefHeight="26.0" prefWidth="180.0"
              text="Gestionar Actividades"
              disable="true" />
   </children>
</AnchorPane>

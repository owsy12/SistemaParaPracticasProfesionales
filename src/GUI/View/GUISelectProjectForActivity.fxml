<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="560.0" prefWidth="820.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.SelectProjectForActivityController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUISelectProjectForActivityStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PROFESOR · ACTIVIDADES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Seleccionar Proyecto para Actividades" styleClass="viewTitleLabel"/>
                        <Label text="Elige un proyecto del listado para agregar o administrar sus actividades."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Proyectos activos" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <TableView fx:id="projectsTable"
                                       styleClass="mainDataTableView"
                                       prefHeight="320.0">
                                <columns>
                                    <TableColumn fx:id="colName" prefWidth="240.0" text="Nombre del proyecto">
                                        <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="colOrganization" prefWidth="220.0" text="Organización">
                                        <cellValueFactory><PropertyValueFactory property="organizationNameDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="colPeriod" prefWidth="160.0" text="Período">
                                        <cellValueFactory><PropertyValueFactory property="periodDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="addActivityButton"
                                    text="Agregar Actividad" styleClass="secondaryActionButton"
                                    disable="true"
                                    onAction="#openAddActivity" mnemonicParsing="false"/>
                            <Button fx:id="manageActivitiesButton"
                                    text="Gestionar Actividades" styleClass="primaryActionButton"
                                    disable="true"
                                    onAction="#openManageActivities" mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

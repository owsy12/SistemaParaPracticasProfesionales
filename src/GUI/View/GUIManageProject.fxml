<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane fx:id="anchorPane"
            prefHeight="560.0" prefWidth="820.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ManegeProjectController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIManageProjectStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="COORDINACIÓN · PROYECTOS" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Gestión de Proyectos" styleClass="viewTitleLabel"/>
                        <Label text="Selecciona un proyecto para actualizarlo o eliminarlo del catálogo."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Proyectos registrados" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <TableView fx:id="tableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="340.0">
                                <columns>
                                    <TableColumn fx:id="nrcColumn" prefWidth="70.0" text="NRC">
                                        <cellValueFactory><PropertyValueFactory property="idProyectDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="nameColumn" prefWidth="140.0" text="Nombre">
                                        <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="organizationColumn" prefWidth="150.0" text="Organización">
                                        <cellValueFactory><PropertyValueFactory property="organizationName"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="capacityColumn" prefWidth="70.0" text="Cupo">
                                        <cellValueFactory><PropertyValueFactory property="maximumPlacesDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="startDateColumn" prefWidth="110.0" text="F. Inicio">
                                        <cellValueFactory><PropertyValueFactory property="startDateDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="endDateColumn" prefWidth="110.0" text="F. Fin">
                                        <cellValueFactory><PropertyValueFactory property="endDateDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Cancelar" styleClass="cancelActionButton"
                                    onAction="#cancelAction" mnemonicParsing="false"/>
                            <Button text="Eliminar" styleClass="rejectActionButton"
                                    onAction="#deleteProject" mnemonicParsing="false"/>
                            <Button text="Actualizar" styleClass="primaryActionButton"
                                    onAction="#updateProject" mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

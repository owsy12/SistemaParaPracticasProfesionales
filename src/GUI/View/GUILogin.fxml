<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Controller.LoginController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="237.0" layoutY="26.0" text="Bienvenido" textAlignment="CENTER">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <VBox layoutX="129.0" layoutY="89.0" prefHeight="222.0" prefWidth="343.0" spacing="10.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="10.0" text="Usuario" textAlignment="CENTER">
               <font>
                  <Font size="27.0" />
               </font>
            </Label>
            <TextField fx:id="userTextField" />
            <Label alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="46.0" text="Contraseña" textAlignment="CENTER">
               <font>
                  <Font size="27.0" />
               </font>
            </Label>
            <PasswordField fx:id="passwordField" prefHeight="39.0" prefWidth="523.0" />
         </children>
      </VBox>
      <Button layoutX="256.0" layoutY="311.0" mnemonicParsing="false" onAction="#clickLogin" text="Iniciar Sesion" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" prefHeight="540.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.AddActivityController">
   <children>
      <Label layoutX="20.0" layoutY="14.0" text="Agregar Actividad al Proyecto">
         <font><Font size="18.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="60.0" text="Proyecto:" />
      <ComboBox fx:id="projectComboBox" layoutX="20.0" layoutY="78.0"
                prefHeight="26.0" prefWidth="480.0" />

      <Label layoutX="20.0" layoutY="118.0" text="Nombre de la actividad:" />
      <TextField fx:id="nameTextField" layoutX="20.0" layoutY="136.0"
                 prefHeight="26.0" prefWidth="480.0" />

      <Label layoutX="20.0" layoutY="176.0" text="Descripción:" />
      <TextArea fx:id="descriptionTextArea" layoutX="20.0" layoutY="194.0"
                prefHeight="90.0" prefWidth="480.0" wrapText="true" />

      <Label layoutX="20.0" layoutY="300.0" text="Semana de inicio planificada (1-8):" />
      <Spinner fx:id="semanaInicioSpinner" layoutX="20.0" layoutY="318.0"
               prefHeight="26.0" prefWidth="100.0" />

      <Label layoutX="140.0" layoutY="300.0" text="Semana de fin planificada (1-8):" />
      <Spinner fx:id="semanaFinSpinner" layoutX="140.0" layoutY="318.0"
               prefHeight="26.0" prefWidth="100.0" />

      <Label layoutX="20.0" layoutY="358.0" text="Fecha de inicio:" />
      <DatePicker fx:id="fechaInicioPicker" layoutX="20.0" layoutY="376.0"
                  prefHeight="26.0" prefWidth="220.0" />

      <Label layoutX="260.0" layoutY="358.0" text="Fecha de fin (límite de entrega):" />
      <DatePicker fx:id="fechaFinPicker" layoutX="260.0" layoutY="376.0"
                  prefHeight="26.0" prefWidth="220.0" />

      <Button layoutX="400.0" layoutY="480.0" mnemonicParsing="false"
              onAction="#saveActivity" prefHeight="26.0" prefWidth="100.0" text="Guardar" />
      <Button layoutX="290.0" layoutY="480.0" mnemonicParsing="false"
              onAction="#cancelAction" prefHeight="26.0" prefWidth="100.0" text="Cancelar" />
   </children>
</AnchorPane>

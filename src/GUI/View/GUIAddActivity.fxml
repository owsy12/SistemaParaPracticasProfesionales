<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane fx:id="anchorPane"
            prefHeight="640.0" prefWidth="720.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.AddActivityController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIAddActivityStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PROFESOR · ACTIVIDADES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Agregar Actividad al Proyecto" styleClass="viewTitleLabel"/>
                        <Label text="Define una nueva actividad dentro del proyecto seleccionado y su período de ejecución."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="+" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Datos de la actividad" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="18.0">
                            <padding><Insets top="26.0" right="36.0" bottom="26.0" left="36.0"/></padding>

                            <GridPane hgap="0.0" vgap="20.0" maxWidth="Infinity">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="180.0" minWidth="140.0" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                                </columnConstraints>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Proyecto" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <ComboBox fx:id="projectComboBox"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Nombre de la actividad" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <RestrictedTextField fx:id="nameTextField"
                                                         styleClass="formTextField" maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="TOP_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <padding><Insets top="8.0" right="18.0"/></padding>
                                    <Label text="Descripción" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <RestrictedTextArea fx:id="descriptionTextArea"
                                                        styleClass="formTextArea"
                                                        wrapText="true"
                                                        prefHeight="110.0" maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Fecha de inicio" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <DatePicker fx:id="startDatePicker"
                                                styleClass="formDatePicker" maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="4">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Fecha límite" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <DatePicker fx:id="endDatePicker"
                                                styleClass="formDatePicker" maxWidth="Infinity"/>
                                    <Label text="Fecha límite de entrega de la actividad" styleClass="fieldHintLabel"/>
                                </VBox>

                            </GridPane>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Cancelar" styleClass="cancelActionButton"
                                    onAction="#cancelAction" mnemonicParsing="false"/>
                            <Button text="&#10003;  Guardar" styleClass="primaryActionButton"
                                    onAction="#saveActivity" mnemonicParsing="false"/>
                        </HBox>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

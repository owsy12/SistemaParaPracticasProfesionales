<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" prefHeight="378.0" prefWidth="625.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Controller.RequestProjectController">
   <children>
      <TableView fx:id="projectsTableView" layoutY="85.0" maxHeight="250.0">
        <columns>
            <TableColumn fx:id="nrcColumn" prefWidth="75.0" text="NRC">
               <cellValueFactory><PropertyValueFactory property="idProyectDisplay"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="nameColumn" prefWidth="90.0" text="Nombre">
               <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="descriptionColumn" prefWidth="73.0" text="Descripcion">
               <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="organizationColumn" prefWidth="90.0" text="Organizacion">
               <cellValueFactory><PropertyValueFactory property="organizationName"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="placesColumn" prefWidth="60.0" text="lugares">
               <cellValueFactory><PropertyValueFactory property="maximumPlacesDisplay"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="startDateColumn" prefWidth="76.0" text="fecha inicio">
               <cellValueFactory><PropertyValueFactory property="startDateFormatted"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="endDateColumn" prefWidth="82.0" text="fecha fin">
               <cellValueFactory><PropertyValueFactory property="endDateFormatted"/></cellValueFactory>
            </TableColumn>
        </columns>
      </TableView>
      <Label layoutX="24.0" layoutY="54.0" prefHeight="37.0" prefWidth="540.0" text="Seleccione 3 proyectos (use Ctrl+clic para selección múltiple)">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="14.0" prefHeight="31.0" prefWidth="571.0" text="Seleccion de proyectos" textAlignment="CENTER">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
      <Button layoutX="469.0" layoutY="352.0" mnemonicParsing="false" onAction="#projectSelectionListButton" text="Ver seleccion" />
   </children>
</AnchorPane>

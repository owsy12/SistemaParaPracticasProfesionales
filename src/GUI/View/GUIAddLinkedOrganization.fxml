<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane fx:id="anchorPane"
            prefHeight="560.0" prefWidth="720.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.AddLinkedOrganizationController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIAddLinkedOrganizationStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="COORDINACIÓN · ORGANIZACIONES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Registrar Organización" styleClass="viewTitleLabel"/>
                        <Label text="Registra una nueva organización vinculada para ofertar vacantes de práctica."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="+" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Datos de la organización" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="18.0">
                            <padding><Insets top="26.0" right="36.0" bottom="26.0" left="36.0"/></padding>

                            <GridPane hgap="0.0" vgap="20.0" maxWidth="Infinity">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="210.0" minWidth="160.0" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                                </columnConstraints>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Nombre" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <RestrictedTextField fx:id="organizationNameTextField"
                                                         promptText="Ingrese el nombre"
                                                         styleClass="formTextField"
                                                         maxWidth="Infinity"/>
                                    <Label text="Razón social de la organización"
                                           styleClass="fieldHintLabel"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Correo" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <RestrictedTextField fx:id="organizationEmailTextField"
                                                         promptText="correo@ejemplo.com"
                                                         styleClass="formTextField"
                                                         maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Dirección" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <RestrictedTextField fx:id="organizationAddressTextField"
                                                         promptText="Dirección completa"
                                                         styleClass="formTextField"
                                                         maxWidth="Infinity"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="2.0"
                                      GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <padding><Insets right="18.0"/></padding>
                                    <Label text="Sector" styleClass="fieldLabelText"/>
                                    <Label text=" *" styleClass="requiredMarkLabel"/>
                                </HBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <ComboBox fx:id="sectorComboBox"
                                              promptText="Selecciona el sector"
                                              styleClass="formComboBox"
                                              maxWidth="Infinity"/>
                                </VBox>

                            </GridPane>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Cancelar"
                                    styleClass="cancelActionButton"
                                    onAction="#cancel"
                                    mnemonicParsing="false"/>

                            <Button text="&#10003;  Registrar"
                                    styleClass="primaryActionButton"
                                    onAction="#addOrganization"
                                    mnemonicParsing="false"/>
                        </HBox>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

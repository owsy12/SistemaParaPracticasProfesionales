<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="500.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.MainMenuController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIProviiconalStyles.css"/>
    </stylesheets>

    <children>
        <VBox styleClass="subViewContentVBox" spacing="20.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

            <VBox styleClass="viewHeaderVBox" spacing="5.0">
                <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                    <Label text="SGPP · MENÚ PROVISIONAL" styleClass="viewBreadcrumbLabel"/>
                </HBox>
                <Label text="Menú Provisional" styleClass="viewTitleLabel"/>
                <Label text="Accesos directos provisionales del sistema."
                       styleClass="viewSubtitleLabel"/>
            </VBox>

            <Separator styleClass="viewTopAccentSeparator"/>

            <VBox styleClass="formCardVBox">

                <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                    <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                    <StackPane styleClass="formSectionIconStackPane">
                        <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                    </StackPane>
                    <Label text="Acciones rápidas" styleClass="formSectionTitleLabel"/>
                </HBox>

                <VBox spacing="12.0" alignment="CENTER_LEFT">
                    <padding><Insets top="22.0" right="32.0" bottom="22.0" left="32.0"/></padding>
                    <Button text="Registrar Organización" styleClass="primaryActionButton"
                            maxWidth="Infinity"
                            onAction="#openRegisterOrganization" mnemonicParsing="false"/>
                    <Button text="Registrar Técnico" styleClass="primaryActionButton"
                            maxWidth="Infinity"
                            onAction="#openRegisterTechnician" mnemonicParsing="false"/>
                    <Button text="Consultar Organizaciones" styleClass="secondaryActionButton"
                            maxWidth="Infinity"
                            onAction="#viewOrganizations" mnemonicParsing="false"/>
                </VBox>

                <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                    <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Salir" styleClass="cancelActionButton"
                            onAction="#exit" mnemonicParsing="false"/>
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane fx:id="rootPane"
            prefHeight="980.0" prefWidth="940.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.GenerateReportController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIGenerateReportStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PRACTICANTE · REPORTES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Generar Reporte de Prácticas" styleClass="viewTitleLabel"/>
                        <Label text="Construye el reporte parcial o final con tus actividades, metodología, resultados y entregables."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9786;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Información general" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <HBox spacing="22.0">
                                <Label fx:id="internNameLabel" text="Practicante: —"
                                       styleClass="infoValueLabel" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="projectLabel" text="Proyecto: —"
                                       styleClass="infoValueLabel" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="approvedHoursLabel" text="Horas validadas: 0"
                                       styleClass="infoValueLabel"/>
                            </HBox>

                            <HBox spacing="16.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Tipo de reporte" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="reportTypeComboBox"
                                              onAction="#handleReportTypeChange"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Mes" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="monthComboBox"
                                              onAction="#handleMonthChange"
                                              visible="false"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Horas del período" styleClass="fieldLabelText"/>
                                    <RestrictedTextField fx:id="reportedHoursTextField"
                                                         visible="false"
                                                         styleClass="formTextField" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="No. de informe" styleClass="fieldLabelText"/>
                                    <RestrictedTextField fx:id="reportNumberTextField"
                                                         visible="false"
                                                         styleClass="formTextField" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9998;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Contenido del reporte" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <VBox spacing="6.0">
                                <Label text="Metodología" styleClass="fieldLabelText"/>
                                <RestrictedTextArea fx:id="methodologyTextArea"
                                                    visible="false"
                                                    wrapText="true"
                                                    styleClass="formTextArea"
                                                    prefHeight="80.0" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Resultados obtenidos" styleClass="fieldLabelText"/>
                                <RestrictedTextArea fx:id="resultsTextArea"
                                                    visible="false"
                                                    wrapText="true"
                                                    styleClass="formTextArea"
                                                    prefHeight="70.0" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Observaciones generales" styleClass="fieldLabelText"/>
                                <RestrictedTextArea fx:id="observationsTextArea"
                                                    visible="false"
                                                    wrapText="true"
                                                    styleClass="formTextArea"
                                                    prefHeight="60.0" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Actividades del Proyecto" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <Label text="Selecciona y agrega actividades al reporte:" styleClass="fieldLabelText"/>

                            <TableView fx:id="projectActivitiesTable"
                                       styleClass="mainDataTableView"
                                       prefHeight="160.0">
                                <columns>
                                    <TableColumn fx:id="columnActName" prefWidth="280.0" text="Nombre">
                                        <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnActDesc" prefWidth="310.0" text="Descripción">
                                        <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnActPlanStart" prefWidth="120.0" text="Fecha inicio">
                                        <cellValueFactory><PropertyValueFactory property="fechaInicioDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnActPlanEnd" prefWidth="120.0" text="Fecha fin">
                                        <cellValueFactory><PropertyValueFactory property="fechaFinDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <HBox spacing="10.0">
                                <Button text="+ Agregar al reporte" styleClass="secondaryActionButton"
                                        onAction="#addActivityToReport" mnemonicParsing="false"/>
                                <Button text="- Eliminar del reporte" styleClass="cancelActionButton"
                                        onAction="#removeActivityFromReport" mnemonicParsing="false"/>
                            </HBox>

                            <Separator styleClass="formDashedSeparator"/>

                            <Label text="Actividades incluidas en el reporte:" styleClass="fieldLabelText"/>
                            <TableView fx:id="reportActivitiesTable"
                                       styleClass="mainDataTableView"
                                       prefHeight="140.0">
                                <columns>
                                    <TableColumn fx:id="columnRaName" prefWidth="320.0" text="Actividad">
                                        <cellValueFactory><PropertyValueFactory property="activityName"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnRangePeriod" prefWidth="240.0" text="Período / Semanas">
                                        <cellValueFactory><PropertyValueFactory property="periodDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnRangeDetail" prefWidth="270.0" text="Avance / Obs.">
                                        <cellValueFactory><PropertyValueFactory property="detailDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9873;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label fx:id="deliverablesLabel" text="Entregables del reporte final"
                                   visible="false"
                                   styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <TableView fx:id="reportDeliverablesTable"
                                       visible="false"
                                       styleClass="mainDataTableView"
                                       prefHeight="140.0">
                                <columns>
                                    <TableColumn fx:id="columnRreportdDeliverableResult" prefWidth="210.0" text="Resultado entregable">
                                        <cellValueFactory><PropertyValueFactory property="resultado"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnReportDeliverableDesc" prefWidth="220.0" text="Descripción">
                                        <cellValueFactory><PropertyValueFactory property="descripcionDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnReportdDeliverableAdvance" prefWidth="90.0" text="Avance">
                                        <cellValueFactory><PropertyValueFactory property="advanceDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="columnReportDeliverableObseervations" prefWidth="310.0" text="Observaciones">
                                        <cellValueFactory><PropertyValueFactory property="observacionesDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <HBox spacing="10.0">
                                <Button fx:id="addDeliverableButton"
                                        text="+ Agregar entregable" styleClass="secondaryActionButton"
                                        visible="false"
                                        onAction="#addDeliverableToReport" mnemonicParsing="false"/>
                                <Button fx:id="removeDeliverableButton"
                                        text="- Eliminar seleccionado" styleClass="cancelActionButton"
                                        visible="false"
                                        onAction="#removeDeliverableFromReport" mnemonicParsing="false"/>
                            </HBox>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_RIGHT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Cancelar" styleClass="cancelActionButton"
                                    onAction="#cancelAction" mnemonicParsing="false"/>
                            <Button fx:id="generateButton"
                                    text="&#9776;  Generar Reporte PDF" styleClass="primaryActionButton"
                                    onAction="#generateReport" mnemonicParsing="false"/>
                        </HBox>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="620.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ViewInterProjectSelection">
   <children>
      <HBox layoutX="28.0" layoutY="14.0" prefHeight="26.0" prefWidth="560.0">
         <children>
            <Label text="Proyectos para: ">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="internNameLabel" text="...">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </HBox>

      <Label layoutX="28.0" layoutY="46.0"
             text="Las selecciones originales aparecen primero. Asignar un proyecto diferente requiere justificación."
             style="-fx-text-fill: #555555;" />

      <TableView fx:id="projectsTableView" layoutX="28.0" layoutY="70.0"
                 prefHeight="310.0" prefWidth="564.0">
        <columns>
            <TableColumn fx:id="projetcNameColumn"  prefWidth="148.0" text="Proyecto">
               <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="organizationColumn" prefWidth="110.0" text="Organización">
               <cellValueFactory><PropertyValueFactory property="organizationName"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="placesColumn"       prefWidth="60.0"  text="Lugares">
               <cellValueFactory><PropertyValueFactory property="avaliablePlacesDisplay"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="datesColumn"        prefWidth="121.0" text="Fechas">
               <cellValueFactory><PropertyValueFactory property="periodIsoDisplay"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="typeColumn"         prefWidth="125.0" text="Tipo">
               <cellValueFactory><PropertyValueFactory property="preferenceLabel"/></cellValueFactory>
            </TableColumn>
        </columns>
      </TableView>

      <Button layoutX="450.0" layoutY="394.0" mnemonicParsing="false"
              onAction="#assignProject" prefHeight="26.0" prefWidth="142.0" text="Asignar" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="1020.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.EvaluateReportController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIEvaluateReportStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PROFESOR · EVALUACIÓN DE REPORTES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Evaluar Reportes de Practicantes" styleClass="viewTitleLabel"/>
                        <Label text="Revisa los reportes entregados por tus practicantes y registra tu evaluación o las observaciones correspondientes."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Reportes a evaluar" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <HBox spacing="16.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Proyecto" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="projectComboBox"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Practicante" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="internComboBox"
                                              disable="true"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <TableView fx:id="reportsTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="220.0">
                                <columns>
                                    <TableColumn fx:id="numberColumn" prefWidth="60.0" text="No.">
                                        <cellValueFactory><PropertyValueFactory property="idReportDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Tipo">
                                        <cellValueFactory><PropertyValueFactory property="reportType"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="periodColumn" prefWidth="140.0" text="Período">
                                        <cellValueFactory><PropertyValueFactory property="period"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="hoursColumn" prefWidth="80.0" text="Horas">
                                        <cellValueFactory><PropertyValueFactory property="reportedHoursDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="dateColumn" prefWidth="280.0" text="Fecha entrega">
                                        <cellValueFactory><PropertyValueFactory property="dateDisplay"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#8505;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Detalle del reporte" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <Label fx:id="reportDetailLabel" text="" styleClass="tableDetailLabel" wrapText="true"/>

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Documento generado:" styleClass="infoKeyLabel"/>
                                <Label fx:id="documentPathLabel" text="—" styleClass="infoValueLabel"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="openDocumentButton" text="Abrir"
                                        styleClass="tableRowButton"
                                        onAction="#openDocument" mnemonicParsing="false"/>
                                <Button fx:id="saveDocumentButton" text="Guardar"
                                        styleClass="tableRowButton"
                                        onAction="#saveDocumentCopy" mnemonicParsing="false"/>
                            </HBox>

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Documento firmado:" styleClass="infoKeyLabel"/>
                                <Label fx:id="signedPathLabel" text="—" styleClass="infoValueLabel"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="openSignedButton" text="Abrir"
                                        styleClass="tableRowButton"
                                        onAction="#openSignedDocument" mnemonicParsing="false"/>
                                <Button fx:id="saveSignedButton" text="Guardar"
                                        styleClass="tableRowButton"
                                        onAction="#saveSignedCopy" mnemonicParsing="false"/>
                            </HBox>

                            <Label text="Actividades del reporte:" styleClass="fieldLabelText"/>
                            <TableView fx:id="activitiesTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="170.0">
                                <columns>
                                    <TableColumn fx:id="activityNameColumn" prefWidth="340.0" text="Actividad">
                                        <cellValueFactory><PropertyValueFactory property="activityName"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="activityPeriodColumn" prefWidth="220.0" text="Período">
                                        <cellValueFactory><PropertyValueFactory property="periodDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="activityObservationColumn" prefWidth="240.0" text="Observaciones">
                                        <cellValueFactory><PropertyValueFactory property="observaciones"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <Label text="Observaciones del profesor:" styleClass="fieldLabelText"/>
                            <RestrictedTextArea fx:id="observationsTextArea"
                                                styleClass="formTextArea"
                                                wrapText="true" prefHeight="90.0" maxWidth="Infinity"/>

                            <Label text="Calificación del reporte (0 a 10):" styleClass="fieldLabelText"/>
                            <RestrictedTextField fx:id="gradeTextField"
                                                 styleClass="formTextField" maxWidth="120.0"/>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Button fx:id="rejectButton" text="Rechazar" styleClass="rejectActionButton"
                                    onAction="#rejectReport" mnemonicParsing="false"/>
                            <Button fx:id="markInReviewButton" text="&#10003;  Evaluar" styleClass="approveActionButton"
                                    onAction="#evaluateReport" mnemonicParsing="false"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Limpiar" styleClass="cancelActionButton"
                                    onAction="#clearSelection" mnemonicParsing="false"/>
                        </HBox>

                    </VBox>

                    <VBox styleClass="formCardVBox">

                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Documentos iniciales del practicante" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <TableView fx:id="initialFormatsTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="140.0">
                                <columns>
                                    <TableColumn fx:id="initFormatTypeColumn" prefWidth="440.0" text="Tipo de formato">
                                        <cellValueFactory><PropertyValueFactory property="formatType"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="initStatusColumn" prefWidth="220.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn prefWidth="160.0" text="Fecha entrega">
                                        <cellValueFactory><PropertyValueFactory property="submissionDate"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Button text="Abrir documento inicial"
                                        onAction="#openInitialDocument" mnemonicParsing="false"/>
                                <Button text="Ver Autoevaluación"
                                        onAction="#openSelfEvaluation" mnemonicParsing="false"/>
                                <Button text="Ver Evaluación OV"
                                        onAction="#openOVEvaluation" mnemonicParsing="false"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="740.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ViewReportsProfessorController">
   <children>
      <Label layoutX="20.0" layoutY="14.0" text="Reportes de Practicantes">
         <font><Font size="18.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="50.0" text="Filtrar por estado:" />
      <ComboBox fx:id="filterStatusComboBox" layoutX="20.0" layoutY="68.0" onAction="#handleStatusFilter" prefHeight="26.0" prefWidth="200.0" />
      <Button layoutX="230.0" layoutY="68.0" mnemonicParsing="false" onAction="#clearFilter"    prefHeight="26.0" prefWidth="100.0" text="Limpiar filtro" />
      <Button layoutX="340.0" layoutY="68.0" mnemonicParsing="false" onAction="#refreshReports" prefHeight="26.0" prefWidth="100.0" text="Actualizar" />
      <Label fx:id="totalLabel" layoutX="580.0" layoutY="74.0" text="Total: 0" />

      <TableView fx:id="reportsTableView" layoutX="20.0" layoutY="108.0" prefHeight="300.0" prefWidth="700.0">
         <columns>
            <TableColumn fx:id="idColumn"     prefWidth="50.0"  text="ID">
               <cellValueFactory><PropertyValueFactory property="idReport"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="typeColumn"   prefWidth="100.0" text="Tipo">
               <cellValueFactory><PropertyValueFactory property="reportType"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="periodColumn" prefWidth="130.0" text="Período">
               <cellValueFactory><PropertyValueFactory property="period"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="hoursColumn"  prefWidth="70.0"  text="Horas">
               <cellValueFactory><PropertyValueFactory property="reportedHours"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Estado">
               <cellValueFactory><PropertyValueFactory property="displayStatus"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="dateColumn"   prefWidth="210.0" text="Fecha entrega">
               <cellValueFactory><PropertyValueFactory property="dateDisplay"/></cellValueFactory>
            </TableColumn>
         </columns>
      </TableView>

      <Label fx:id="detailLabel" layoutX="20.0" layoutY="422.0" prefWidth="700.0" text="" wrapText="true" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="700.0" prefWidth="860.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.ViewReportsProfessorController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIViewReportsProfessorStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PROFESOR · REPORTES" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Reportes de Practicantes" styleClass="viewTitleLabel"/>
                        <Label text="Consulta los reportes entregados por tus practicantes filtrando por proyecto, practicante y estado."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9776;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Filtros y resultados" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <HBox spacing="16.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Proyecto" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="projectComboBox" styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Practicante" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="internComboBox" disable="true"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Filtrar por estado" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="filterStatusComboBox"
                                              onAction="#handleStatusFilter"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <Button text="Limpiar filtro" styleClass="cancelActionButton"
                                        onAction="#clearFilter" mnemonicParsing="false"/>
                                <Button text="Actualizar" styleClass="secondaryActionButton"
                                        onAction="#refreshReports" mnemonicParsing="false"/>
                                <Label fx:id="totalLabel" text="Total: 0" styleClass="tableSummaryLabel"/>
                            </HBox>

                            <TableView fx:id="reportsTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="300.0">
                                <columns>
                                    <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID"/>
                                    <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Tipo"/>
                                    <TableColumn fx:id="periodColumn" prefWidth="160.0" text="Período"/>
                                    <TableColumn fx:id="hoursColumn" prefWidth="80.0" text="Horas"/>
                                    <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Estado"/>
                                    <TableColumn fx:id="dateColumn" prefWidth="240.0" text="Fecha entrega"/>
                                </columns>
                            </TableView>

                            <Label fx:id="detailLabel" text=""
                                   styleClass="tableDetailLabel" wrapText="true"/>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

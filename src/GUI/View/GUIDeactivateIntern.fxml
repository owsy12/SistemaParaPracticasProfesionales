<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        fx:id="anchorPane"
        stylesheets="@css/GUIDeactivateInternStyles.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="GUI.Controller.DeactivateInterController">

    <ScrollPane
            styleClass="subViewScrollPane"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

        <content>
            <VBox styleClass="subViewContentVBox" spacing="20.0">
                <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                <VBox styleClass="viewHeaderVBox" spacing="5.0">
                    <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                        <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                        <Label text="ADMINISTRACIÓN · PRACTICANTES" styleClass="viewBreadcrumbLabel"/>
                    </HBox>
                    <Label text="Inactivar Practicante" styleClass="viewTitleLabel"/>
                    <Label text="Suspende a un practicante por baja académica o renuncia. Sus horas acumuladas se preservan."
                           styleClass="viewSubtitleLabel"/>
                </VBox>

                <Separator styleClass="viewTopAccentSeparator"/>

                <VBox styleClass="formCardVBox">

                    <VBox styleClass="tableSearchVBox">
                        <padding><Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/></padding>
                        <HBox styleClass="tableSearchBarHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="0.0" right="14.0" bottom="0.0" left="14.0"/></padding>
                            <Label text="&#8981;" styleClass="tableSearchIconLabel"/>
                            <TextField fx:id="searchTextField"
                                       promptText="Buscar por matrícula o nombre..."
                                       styleClass="tableSearchTextField"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <Separator styleClass="formCardSeparator"/>

                    <TableView fx:id="internsTableView"
                               styleClass="mainDataTableView"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="tagColumn"
                                         text="MATRÍCULA"
                                         prefWidth="180.0"/>
                            <TableColumn fx:id="interFullNameColumn"
                                         text="NOMBRE COMPLETO"
                                         prefWidth="400.0"/>
                            <TableColumn fx:id="statusColumn"
                                         text="ESTADO"
                                         prefWidth="140.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox styleClass="tableFooterHBox" alignment="CENTER_LEFT" spacing="10.0">
                        <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                        <Label fx:id="recordCountLabel"
                               text="0 de 0 registros"
                               styleClass="tableSummaryLabel"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Cancelar"
                                styleClass="cancelActionButton"
                                onAction="#cancelOperation"
                                mnemonicParsing="false"/>
                        <Button text="Inactivar"
                                styleClass="tableDeactivateButton"
                                onAction="#inactivateIntern"
                                mnemonicParsing="false"/>
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>

</AnchorPane>

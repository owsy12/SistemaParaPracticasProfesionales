<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Controller.UploadInitialDocumentsController">
    <!-- TITULO -->

    <Label layoutX="195.0" layoutY="30.0" style="-fx-font-size: 24px;                   -fx-font-weight: bold;" text="Subida de Documentos" />

    <!-- COMBOBOX -->

    <Label layoutX="70.0" layoutY="93.0" style="-fx-font-size: 14px;                   -fx-font-weight: bold;" text="Tipo de documento" />

    <ComboBox fx:id="comboBoxDocumentType" layoutX="70.0" layoutY="120.0" prefHeight="40.0" prefWidth="500.0" promptText="Seleccione un documento" />

    <!-- ZONA DRAG AND DROP -->

    <Pane fx:id="dropZone" layoutX="62.0" layoutY="188.0" prefHeight="180.0" prefWidth="500.0" style="-fx-background-color: white;                  -fx-border-color: #bdbdbd;                  -fx-border-width: 2;                  -fx-border-style: dashed;">

        <children>

            <Label layoutX="90.0" layoutY="60.0" style="-fx-font-size: 18px;                           -fx-text-fill: #616161;" text="Arrastra y suelta el archivo PDF aquí" />

            <Label fx:id="labelFileName" layoutX="146.0" layoutY="90.0" style="-fx-font-size: 13px;                           -fx-text-fill: #9e9e9e;" text="Ningún archivo seleccionado" />

        </children>

    </Pane>

    <!-- BOTONES -->

    <Button fx:id="btnSelectFile" layoutX="182.0" layoutY="410.0" onAction="#openFileChooser" prefHeight="29.0" prefWidth="138.0" style="-fx-font-size: 14px;" text="Seleccionar Archivo" />

    <Button fx:id="btnUpload" layoutX="393.0" layoutY="410.0" onAction="#uploadDocument" prefHeight="29.0" prefWidth="157.0" style="-fx-font-size: 14px;                    -fx-background-color: #1976d2;                    -fx-text-fill: white;" text="Subir Documento" />

    <!-- MENSAJE -->

    <Label fx:id="labelStatus" layoutX="180.0" layoutY="470.0" style="-fx-font-size: 13px;                   -fx-text-fill: red;" text="" />
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" prefHeight="280.0" prefWidth="420.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.AddEducationalExperienceController">
   <children>
      <Label layoutX="28.0" layoutY="16.0" text="Registrar Experiencia Educativa">
         <font>
            <Font size="18.0" />
         </font>
      </Label>

      <Label layoutX="28.0" layoutY="64.0" text="NRC:" />
      <TextField fx:id="nrcTextField" layoutX="28.0" layoutY="84.0" prefHeight="26.0" prefWidth="160.0" promptText="Ej: 12345" />

      <Label layoutX="28.0" layoutY="124.0" text="Nombre de la experiencia educativa:" />
      <TextField fx:id="nameTextField" layoutX="28.0" layoutY="144.0" prefHeight="26.0" prefWidth="364.0" promptText="Ej: Desarrollo de Software" />

      <Label layoutX="28.0" layoutY="184.0" text="Profesor asignado:" />
      <ComboBox fx:id="professorComboBox" layoutX="28.0" layoutY="204.0" prefHeight="26.0" prefWidth="364.0" />

      <Button layoutX="284.0" layoutY="242.0" mnemonicParsing="false" onAction="#save" prefHeight="26.0" prefWidth="108.0" text="Guardar" />
      <Button layoutX="180.0" layoutY="242.0" mnemonicParsing="false" onAction="#cancel" text="Cancelar" />
   </children>
</AnchorPane>

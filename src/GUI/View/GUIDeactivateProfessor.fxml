<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.DeactivateProfessorController">
    <children>
        <Label layoutX="25.0" layoutY="24.0" text="Inactivar Profesor">
            <font><Font size="19.0" /></font>
        </Label>
        <TableView fx:id="tableView" layoutX="25.0" layoutY="63.0"
                   prefHeight="274.0" prefWidth="550.0">
            <columns>
                <TableColumn fx:id="tagColumn"            prefWidth="90.0"  text="No. Personal" />
                <TableColumn fx:id="nameColumn"           prefWidth="90.0"  text="Nombre" />
                <TableColumn fx:id="lastNameColumn"       prefWidth="94.0"  text="Ap. Paterno" />
                <TableColumn fx:id="secondLastNameColumn" prefWidth="107.0" text="Ap. Materno" />
                <TableColumn fx:id="academicDegreeColumn" prefWidth="169.0" text="Área Académica" />
            </columns>
        </TableView>
        <Button layoutX="25.0"  layoutY="353.0" mnemonicParsing="false"
                onAction="#cancelOperation" text="Cancelar" />
        <Button layoutX="450.0" layoutY="353.0" mnemonicParsing="false"
                onAction="#inactivateProfessor" text="Inactivar" />
    </children>
</AnchorPane>

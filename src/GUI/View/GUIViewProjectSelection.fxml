<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.Controller.ViewProjectSelectionController"
            fx:id="anchorPane"
            prefHeight="400.0" prefWidth="600.0">

    <VBox AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="flowProjects" hgap="15" vgap="15" />
            </content>
        </ScrollPane>

        <HBox spacing= "10.0" alignment="CENTER_RIGHT" >
            <Button text="Regresar" onAction="#handleRegresar"/>
            <Button text="Cancelar" onAction="#handleCancelar"/>
            <Button text="Confirmar" onAction="#confirmButtom"/>
        </HBox>

    </VBox>
</AnchorPane>

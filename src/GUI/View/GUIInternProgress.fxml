<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import GUI.Utils.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="820.0" prefWidth="840.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.InternProgressController">

    <stylesheets>
        <URL value="@css/SGPPTheme.css"/>
        <URL value="@css/GUIInternProgressStyles.css"/>
    </stylesheets>

    <children>
        <ScrollPane styleClass="subViewScrollPane"
                    fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox styleClass="subViewContentVBox" spacing="20.0">
                    <padding><Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/></padding>

                    <VBox styleClass="viewHeaderVBox" spacing="5.0">
                        <HBox styleClass="viewBreadcrumbHBox" spacing="6.0" alignment="CENTER_LEFT">
                            <Label text="&#9711;" styleClass="viewBreadcrumbIconLabel"/>
                            <Label text="PRACTICANTE · AVANCE" styleClass="viewBreadcrumbLabel"/>
                        </HBox>
                        <Label text="Registro de Avance de Actividades" styleClass="viewTitleLabel"/>
                        <Label text="Registra y actualiza el avance de las actividades asignadas en tu proyecto."
                               styleClass="viewSubtitleLabel"/>
                    </VBox>

                    <Separator styleClass="viewTopAccentSeparator"/>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9786;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Resumen de avance" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="10.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <Label fx:id="projectLabel" text="Proyecto: —" styleClass="infoValueLabel"/>
                            <HBox spacing="22.0">
                                <Label fx:id="totalHoursLabel" text="Horas registradas: 0" styleClass="tableSummaryLabel"/>
                                <Label fx:id="approvedHoursLabel" text="Horas validadas: 0" styleClass="tableSummaryLabel"/>
                            </HBox>
                            <Label fx:id="partialStatusLabel" text="" styleClass="tableDetailLabel" wrapText="true"/>
                            <Label fx:id="finalStatusLabel" text="" styleClass="tableDetailLabel" wrapText="true"/>

                            <TableView fx:id="activitiesTableView"
                                       styleClass="mainDataTableView"
                                       prefHeight="220.0">
                                <columns>
                                    <TableColumn fx:id="activityNameColumn" prefWidth="280.0" text="Actividad">
                                        <cellValueFactory><PropertyValueFactory property="activityName"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="hoursColumn" prefWidth="100.0" text="Horas">
                                        <cellValueFactory><PropertyValueFactory property="dedicatedHoursDisplay"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Estado">
                                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="observationsColumn" prefWidth="240.0" text="Observaciones">
                                        <cellValueFactory><PropertyValueFactory property="observations"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <VBox styleClass="formCardVBox">
                        <HBox styleClass="formSectionHeaderHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <StackPane styleClass="formSectionIconStackPane">
                                <Label text="&#9998;" styleClass="formSectionIconLabel"/>
                            </StackPane>
                            <Label text="Registrar avance de actividad" styleClass="formSectionTitleLabel"/>
                        </HBox>

                        <VBox spacing="14.0">
                            <padding><Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/></padding>

                            <VBox spacing="6.0">
                                <Label text="Seleccionar actividad" styleClass="fieldLabelText"/>
                                <ComboBox fx:id="activityComboBox"
                                          styleClass="formComboBox" maxWidth="Infinity"/>
                            </VBox>

                            <HBox spacing="14.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Horas dedicadas" styleClass="fieldLabelText"/>
                                    <RestrictedTextField fx:id="hoursTextField"
                                                         styleClass="formTextField" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label text="Estado" styleClass="fieldLabelText"/>
                                    <ComboBox fx:id="statusComboBox"
                                              styleClass="formComboBox" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="6.0">
                                <Label text="Observaciones" styleClass="fieldLabelText"/>
                                <TextArea fx:id="observationsTextArea"
                                          wrapText="true" styleClass="formTextArea"
                                          prefHeight="90.0" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>

                        <HBox styleClass="formActionBarHBox" alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/></padding>
                            <Button text="Guardar Avance" styleClass="primaryActionButton"
                                    onAction="#saveProgress" mnemonicParsing="false"/>
                            <Button text="Actualizar Avance" styleClass="secondaryActionButton"
                                    onAction="#updateProgress" mnemonicParsing="false"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Limpiar" styleClass="cancelActionButton"
                                    onAction="#clearSelection" mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

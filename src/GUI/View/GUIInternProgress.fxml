<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="660.0" prefWidth="720.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controller.InternProgressController">
   <children>
      <Label layoutX="20.0" layoutY="14.0" text="Registro de Avance de Actividades">
         <font><Font size="18.0"/></font>
      </Label>

      <Label fx:id="projectLabel"      layoutX="20.0" layoutY="48.0"  text="Proyecto: —" />
      <Label fx:id="totalHoursLabel"   layoutX="20.0" layoutY="66.0"  text="Horas registradas: 0" />
      <Label fx:id="approvedHoursLabel" layoutX="220.0" layoutY="66.0" text="Horas validadas: 0" />
      <Label fx:id="partialStatusLabel" layoutX="20.0" layoutY="84.0" text="" />
      <Label fx:id="finalStatusLabel"   layoutX="20.0" layoutY="100.0" text="" />

      <TableView fx:id="activitiesTableView" layoutX="20.0" layoutY="118.0" prefHeight="200.0" prefWidth="680.0">
         <columns>
            <TableColumn fx:id="activityNameColumn" prefWidth="260.0" text="Actividad" />
            <TableColumn fx:id="hoursColumn"        prefWidth="80.0"  text="Horas" />
            <TableColumn fx:id="statusColumn"       prefWidth="120.0" text="Estado" />
            <TableColumn fx:id="observationsColumn" prefWidth="200.0" text="Observaciones" />
         </columns>
      </TableView>

      <Label layoutX="20.0" layoutY="334.0" text="Seleccionar actividad:" />
      <ComboBox fx:id="activityComboBox" layoutX="20.0" layoutY="352.0" prefHeight="26.0" prefWidth="680.0" />

      <Label layoutX="20.0" layoutY="390.0" text="Horas dedicadas:" />
      <TextField fx:id="hoursTextField" layoutX="20.0" layoutY="408.0" prefHeight="26.0" prefWidth="200.0" />

      <Label layoutX="240.0" layoutY="390.0" text="Estado:" />
      <ComboBox fx:id="statusComboBox" layoutX="240.0" layoutY="408.0" prefHeight="26.0" prefWidth="200.0" />

      <Label layoutX="20.0" layoutY="446.0" text="Observaciones:" />
      <TextArea fx:id="observationsTextArea" layoutX="20.0" layoutY="464.0" prefHeight="80.0" prefWidth="680.0" wrapText="true" />

      <Button layoutX="20.0"  layoutY="560.0" mnemonicParsing="false" onAction="#saveProgress"   prefHeight="26.0" prefWidth="160.0" text="Guardar Avance" />
      <Button layoutX="190.0" layoutY="560.0" mnemonicParsing="false" onAction="#updateProgress" prefHeight="26.0" prefWidth="160.0" text="Actualizar Avance" />
      <Button layoutX="600.0" layoutY="560.0" mnemonicParsing="false" onAction="#clearSelection" prefHeight="26.0" prefWidth="100.0" text="Limpiar" />
   </children>
</AnchorPane>
